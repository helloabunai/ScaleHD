# Copy to .env (not committed) and adjust. Read by docker compose.

# Folder of FASTQ files on this machine, mounted read-only at /input.
SCALEHD_INPUT=./input

# Samples processed at once, one process each (default: every core).
# SCALEHD_WORKERS=32

# Signs login sessions, once accounts exist. Generate one with
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# SCALEHD_SECRET_KEY=
