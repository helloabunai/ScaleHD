# Copy to .env (not committed) and adjust. Read by docker compose.

# Sequencing data users can browse, read-only. An absolute path on this machine;
# the container sees it at the same path.
SCALEHD_DATA_ROOT=/srv/scalehd/data

# Where results go: a folder per user, a subfolder per job. An absolute path on this
# machine that already exists and is writable by uid 1000, the container's user:
#   sudo mkdir -p /srv/scalehd/workspace && sudo chown 1000 /srv/scalehd/workspace
SCALEHD_WORKSPACE=/srv/scalehd/workspace

# Samples processed at once, one process each (default: every core).
# SCALEHD_WORKERS=32

# Whether anyone who can reach the server may create an account. The first
# account, the admin, can always be created.
# SCALEHD_ALLOW_REGISTRATION=false

# How long a login lasts, in days.
# SCALEHD_SESSION_DAYS=30
